---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { STATUS_LABEL, CATEGORIES, getSource } from '../../lib/content-model';

const { entry } = Astro.locals.starlightRoute;
const { status, lastVerified, reviewedBy, reviewedAt, category } = entry.data;
// Pagefind 필터: 상세 검색 페이지에서 카테고리·상태·근거 법령·태그로 좁힐 수 있게 한다
const basisTitles = [...new Set((entry.data.legalBasis ?? []).map((b) => getSource(b.source)?.title).filter(Boolean))];
const tags = entry.data.tags ?? [];
const fmt = (d?: Date) => d?.toISOString().slice(0, 10);
const categoryLabel = CATEGORIES.find((c) => c.id === category)?.label;
---

<Default />
{categoryLabel && <meta data-pagefind-filter="카테고리[content]" content={categoryLabel} />}
{status && <meta data-pagefind-filter="상태[content]" content={STATUS_LABEL[status]} />}
{basisTitles.map((t) => <meta data-pagefind-filter="근거[content]" content={t} />)}
{tags.map((t) => <meta data-pagefind-filter="태그[content]" content={t} />)}
{
	status && (
		<div class="doc-meta" data-status={status}>
			<span class={`badge badge-${status}`}>{STATUS_LABEL[status]}</span>
			{categoryLabel && <span class="meta-item">{categoryLabel}</span>}
			{lastVerified && (
				<span class="meta-item">
					공식 원문 확인일 <time datetime={fmt(lastVerified)}>{fmt(lastVerified)}</time>
				</span>
			)}
			{reviewedBy && reviewedAt && (
				<span class="meta-item">
					검토 {reviewedBy} · {fmt(reviewedAt)}
				</span>
			)}
		</div>
	)
}
{
	status && status !== 'reviewed' && (
		<p class="doc-meta-note">
			이 문서는 법률 전문가의 검토를 거치지 않았습니다. 법적 판단의 근거로 사용하기 전에 아래 공식 원문을 직접 확인하고,
			필요하면 사내 법무·개인정보 보호책임자와 상의하세요.
		</p>
	)
}
